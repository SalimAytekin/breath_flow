<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Üst Status Bar -->
    <LinearLayout
        android:id="@+id/top_status_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentTop="true"
        android:background="#90000000"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Egzersiz Bilgileri -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_exercise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boyun Döndürme Egzersizi"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tv_fps_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FPS: --"
                    android:textColor="#2196F3"
                    android:textSize="12sp"
                    android:layout_marginEnd="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tekrar Sayısı -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEKRAR"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_repetition_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Durdur Butonu -->
        <Button
            android:id="@+id/btn_stop_coaching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DURDUR"
            android:textSize="12sp"
            android:minHeight="40dp"
            android:padding="8dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="#F44336" />

    </LinearLayout>

    <!-- Sağ Panel - Detaylı Bilgiler -->
    <LinearLayout
        android:id="@+id/right_panel"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/top_status_bar"
        android:layout_above="@+id/bottom_feedback_panel"
        android:background="#85000000"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Form Analizi Başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 FORM ANALİZİ"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <!-- Genel Doğruluk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Genel Doğruluk"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_accuracy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#4CAF50" />

            <TextView
                android:id="@+id/tv_accuracy_percentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Form Detayları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Form Detayları"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Poz Kalitesi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Poz Kalitesi:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_pose_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İyi"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Hareket Akıcılığı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Akıcılık:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_movement_flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orta"
                    android:textColor="#FF9800"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Stabilite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stabilite:"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_stability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mükemmel"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Egzersiz Talimatları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Talimatlar"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tv_exercise_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Egzersiz talimatları yükleniyor..."
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:padding="4dp"
                    android:background="#22FFFFFF" />

            </ScrollView>

        </LinearLayout>

        <!-- Performans İstatistikleri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Performans"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_best_accuracy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="En İyi: --%"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_avg_accuracy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ortalama: --%"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Alt Feedback Panel -->
    <LinearLayout
        android:id="@+id/bottom_feedback_panel"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_alignParentBottom="true"
        android:background="#90000000"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Emoji/Icon -->
        <TextView
            android:id="@+id/tv_feedback_emoji"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="🔄"
            android:textSize="32sp"
            android:gravity="center"
            android:background="#44FFFFFF"
            android:layout_marginEnd="16dp" />

        <!-- Feedback Mesajı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_feedback_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Başlayın"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_feedback_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Boyunuzu yavaşça sağa ve sola döndürün"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:maxLines="4"
                android:lineSpacingMultiplier="1.2"
                android:ellipsize="end"
                android:scrollbars="vertical" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout> 